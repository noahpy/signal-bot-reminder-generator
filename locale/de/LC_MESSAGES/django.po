msgid "Rotate: one person per occurrence, in the order above"
msgstr "Rotieren: eine Person pro Termin, in der Reihenfolge oben"

#: reminders/forms.py:72
msgid "1 = every week, 2 = every other week (needs a start date)"
msgstr "1 = jede Woche, 2 = jede zweite Woche (braucht ein Startdatum)"

#: reminders/forms.py:74
msgid "31 = last day of the month"
msgstr "31 = letzter Tag des Monats"

#: reminders/forms.py:77
msgid "Leave empty for every month"
msgstr "Leer lassen für jeden Monat"

#: reminders/forms.py:82
msgid ""
"One date per line, optionally followed by the name(s) responsible that day "
"(comma separated). Without names, the selected people/rotation apply."
msgstr ""
"Ein Datum pro Zeile, optional gefolgt von den zuständigen Namen (durch Komma"
" getrennt). Ohne Namen gelten die ausgewählten Personen bzw. die Rotation."

#: reminders/forms.py:85
msgid "First date (required for 'every N days'; rotation starts here)"
msgstr "Erster Termin (nötig für „alle N Tage“; die Rotation beginnt hier)"

#: reminders/forms.py:87
msgid "Optional: stop after this date"
msgstr "Optional: nach diesem Datum aufhören"

#: reminders/forms.py:89
msgid "Send the reminder this many days before the date (0 = on the day)"
msgstr "So viele Tage vor dem Termin erinnern (0 = am Tag selbst)"

#: reminders/forms.py:93
#, python-brace-format
msgid ""
"Placeholders: {mentions} {names} {title} {date} {weekday} {days_until} "
"{timing}"
msgstr ""
"Platzhalter: {mentions} {names} {title} {date} {weekday} {days_until} "
"{timing}"

#: reminders/forms.py:136
msgid "Pick at least one weekday."
msgstr "Wähle mindestens einen Wochentag."

#: reminders/forms.py:140
msgid "Needed when not every week."
msgstr "Nötig, wenn nicht jede Woche."

#: reminders/forms.py:148
msgid "Needed for 'every N days'."
msgstr "Nötig für „alle N Tage“."

#: reminders/forms.py:151
msgid "Pick the date."
msgstr "Wähle das Datum."

#: reminders/forms.py:161
#, python-format
msgid "Line %(i)d: can't read '%(line)s' (use 09.11.2026 or 2026-11-09)."
msgstr ""
"Zeile %(i)d: „%(line)s“ ist nicht lesbar (Format 09.11.2026 oder "
"2026-11-09)."

#: reminders/forms.py:166
#, python-format
msgid "Line %(i)d: invalid date '%(date)s'."
msgstr "Zeile %(i)d: ungültiges Datum „%(date)s“."

#: reminders/forms.py:175
#, python-format
msgid "Line %(i)d: no unique group member matches '%(name)s'."
msgstr "Zeile %(i)d: kein eindeutiges Gruppenmitglied passt zu „%(name)s“."

#: reminders/forms.py:183
msgid "Enter at least one date."
msgstr "Gib mindestens ein Datum ein."

#: reminders/forms.py:187
msgid "Rotation needs at least one person."
msgstr "Für die Rotation braucht es mindestens eine Person."

